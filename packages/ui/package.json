{
  "name": "@linode/ui",
  "author": "Linode",
  "description": "Linode UI component library",
  "version": "0.29.0",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsc -w --preserveWatchOutput",
    "lint": "eslint . --quiet --ext .js,.ts,.tsx",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage && open coverage/index.html",
    "coverage:summary": "vitest run --coverage.enabled --reporter=junit --coverage.reporter=json-summary"
  },
  "dependencies": {
    "@akamai/compute-ui-core": "1.0.2",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@linode/design-language-system": "^5.3.2",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.3.11",
    "@mui/utils": "^7.3.11",
    "@mui/x-date-pickers": "^8.12.0",
    "luxon": "3.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tss-react": "^4.8.2"
  },
  "devDependencies": {
    "@linode/tsconfig": "workspace:*",
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/dom": "^10.1.0",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "~16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/luxon": "3.4.2",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.4",
    "storybook": "^10.5.7",
    "vite-plugin-svgr": "^5.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "prettier --write",
      "eslint --ext .js,.ts,.tsx --quiet"
    ]
  }
}
