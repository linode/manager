## UNCOMMENT & UPDATE THESE ENVIRONMENT VARIABLES WITH YOUR INFO,
## THEN SAVE IN packages/manager AS `.env`

##################################
# Required to run the app:
##################################
COMPUTE_LOGIN_ROOT='https://login.linode.com'
COMPUTE_API_ROOT='https://api.linode.com/v4'
# COMPUTE_CLIENT_ID='UPDATE_WITH_YOUR_ID'
COMPUTE_APP_ROOT='http://localhost:3000'

##################################
# Optional:
##################################
# Feature flags with Launch Darkly:
# COMPUTE_LAUNCHDARKLY_CLIENT_ID=

# Error monitoring with Sentry:
# COMPUTE_SENTRY_URL=

# Adobe Analytics:
# COMPUTE_ADOBE_ANALYTICS_URL=

# Pendo:
# COMPUTE_PENDO_API_KEY=

# Embedded live chat URLs:
# COMPUTE_CHAT_DEPLOYMENT_URL=
# COMPUTE_CHAT_SCRT2_URL=
# COMPUTE_CHAT_BOOTSTRAP_JS_URL=
# COMPUTE_CHAT_ORG_ID=
# COMPUTE_CHAT_DEPLOYMENT_NAME=

# Linode Docs search with Algolia:
# COMPUTE_ALGOLIA_APPLICATION_ID=
# COMPUTE_ALGOLIA_SEARCH_KEY=

# Max page size requested of the Linode API:
# COMPUTE_API_MAX_PAGE_SIZE=

# The Statuspage URL for displaying incidents and maintenance:
# COMPUTE_STATUS_PAGE_URL=

# PayPal Client ID
# COMPUTE_PAYPAL_CLIENT_ID=

# @todo deprecate after braintree paypal is released
# The PayPal environment to use ("production" or "sandbox"):
# COMPUTE_PAYPAL_ENV=

# The Google Pay environment to use ("PRODUCTION" or "TEST"):
# COMPUTE_GPAY_ENV=

# The Google Pay Merchant ID to use:
# COMPUTE_GPAY_MERCHANT_ID=

# Set to "true" to disable /event request throttling (useful for E2E tests):
# COMPUTE_DISABLE_EVENT_THROTTLE=

# !!! DANGER !!!
# Access token that overrides the token recieved from Login:
# COMPUTE_ACCESS_TOKEN= !!! YOU PROBABLY DON'T WANT TO USE THIS !!!

# Mock the API with service workers (local development):
# COMPUTE_MOCK_SERVICE_WORKER='true'

## UNCOMMENT AND UPDATE FOR RUNNING E2E TESTS ##
################### WARNING!! ###############################
#  E2E TESTS WILL CREATE AND DELETE RESOURCES ON YOUR ACCOUNT
#  IT WILL ONLY DELETE RESOURCES CREATED BY THE E2E TESTS (STARTING WITH "CY-TEST-")
#  INCLUDING LINODES, VOLUMES, DOMAINS, NODEBALANCERS, CLUSTERS [...]
#  ALTHOUGH SHORT LIVED, THE RESOURCES CREATED BY CYPRESS COULD INCUR EXTRA COSTS FOR USERS OUTSIDE OF THE ORGANIZATION
#MANAGER_OAUTH='YOUR_OATH_TOKEN'
