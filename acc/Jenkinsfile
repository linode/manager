pipeline {
    agent {
        label "fee"
    }

    options {
        disableConcurrentBuilds()
    }

    environment {
        CI = 'true'
        // Vitest JUnit for Jenkins test reporting (full + PR partial runs).
        VITEST_JUNIT_OUT = "${WORKSPACE}/reports/vitest-junit.xml"
    }

    parameters {
        booleanParam(name: 'SKIP_TESTS', defaultValue: false, description: 'Skip running tests on release/* branches')
    }

    stages {
        // Core CI only for protected branches and open PRs — not for every feature-branch push.
        // (Lunabuild must trigger the multibranch *PR* job so CHANGE_ID / BITBUCKET_PR_ID is set;
        // otherwise branch-only indexing runs will skip these stages.)
        stage("Setup pnpm") {
            when {
                anyOf {
                    branch 'develop'
                    branch 'release/*'
                    branch 'staging'
                    branch 'master'
                    branch 'master-cloud-manager-distributed'
                    expression { env.CHANGE_ID != null }
                    expression { env.BITBUCKET_PR_ID != null }
                }
            }
            steps {
              nodejs(configId: "npmrc-ro", nodeJSInstallationName: "v22") {
                sh "node -v"
                sh "npm -v"
                sh "pnpm -v || corepack enable pnpm"
                sh "pnpm install:all"
              }
            }
        }

        stage("Build dependencies") {
            when {
                anyOf {
                    branch 'develop'
                    branch 'release/*'
                    branch 'staging'
                    branch 'master'
                    branch 'master-cloud-manager-distributed'
                    expression { env.CHANGE_ID != null }
                    expression { env.BITBUCKET_PR_ID != null }
                }
            }
            steps {
                nodejs(configId: "npmrc-ro", nodeJSInstallationName: "v22") {
                    sh "pnpm build:validation"
                    sh "pnpm build:sdk"
                }
            }
        }

        stage("Validate") {
            when {
                anyOf {
                    branch 'develop'
                    branch 'release/*'
                    branch 'staging'
                    branch 'master'
                    branch 'master-cloud-manager-distributed'
                    expression { env.CHANGE_ID != null }
                    expression { env.BITBUCKET_PR_ID != null }
                }
            }
            parallel {
                stage("Lint") {
                    steps {
                        nodejs(configId: "npmrc-ro", nodeJSInstallationName: "v22") {
                            sh "pnpm lint:all"
                        }
                    }
                }
                stage("Typecheck") {
                    steps {
                        nodejs(configId: "npmrc-ro", nodeJSInstallationName: "v22") {
                            sh "pnpm -r --parallel typecheck"
                        }
                    }
                }
            }
        }

        stage("Test") {
          when {
            anyOf {
              branch 'develop'
              branch 'release/*'
              branch 'staging'
              branch 'master'
              branch 'master-cloud-manager-distributed'
              expression { env.CHANGE_ID != null }
              expression { env.BITBUCKET_PR_ID != null }
              allOf {
                  branch pattern: "release/*"
                  expression { return !params.SKIP_TESTS }
              }
            }
          }
          steps {
              nodejs(configId: "npmrc-ro", nodeJSInstallationName: "v22") {
                sh "pnpm test:ci"
              }
            }
        }

        stage("Build PR") {
            when {
                expression { env.CHANGE_ID != null } // It's a PR
            }
            steps {
                nodejs(configId: "npmrc-ro", nodeJSInstallationName: "v22") {
                    sh "pnpm build"
                }
            }
        }

        stage("Build develop") {
            when {
                anyOf {
                    branch pattern: "develop"
                }
            }
            environment {
                COMPUTE_API_MAX_PAGE_SIZE = "500"
                COMPUTE_API_ROOT = "https://api.devcloud.linode.com/v4"
                COMPUTE_APP_ROOT = "https://cloud.devcloud.linode.com"
                COMPUTE_CHAT_BOOTSTRAP_JS_URL = "https://akamai--qa.sandbox.my.site.com/ESWAkaChatCompute1778779688044/assets/js/bootstrap.min.js"
                COMPUTE_CHAT_DEPLOYMENT_NAME = "AkaChat_Compute"
                COMPUTE_CHAT_DEPLOYMENT_URL = "https://akamai--qa.sandbox.my.site.com/ESWAkaChatCompute1778779688044"
                COMPUTE_CHAT_ORG_ID = "00DWr00000BiC8n"
                COMPUTE_CHAT_SCRT2_URL = "https://akamai--qa.sandbox.my.salesforce-scrt.com"
                COMPUTE_CLIENT_ID = "4bd20531408b51e73313"
                COMPUTE_LAUNCHDARKLY_CLIENT_ID = "67ed97f93736be0c14fa0ea2"
                COMPUTE_LKE_HIGH_AVAILABILITY_PRICE = "60"
                COMPUTE_LOGIN_ROOT = "https://login.devcloud.linode.com"
                COMPUTE_INFERENCE_BASE_URL = "https://api.dev.akamai-inference.com/v1"
            }
            steps {
                nodejs(configId: "npmrc-ro", nodeJSInstallationName: "v22") {
                    sh "pnpm build"
                    sh "pnpm release --env=develop"
                    sh "pnpm release:cloudpulse --env=develop"
                }
            }
        }

        stage("Build staging") {
            when {
                anyOf {
                    branch pattern: "release/*"
                    branch pattern: "staging"
                }
            }
            environment {
                COMPUTE_PAYPAL_CLIENT_ID = "AWdnFJ_Yx5X9uqKZQdbdkLfCnEJwtauQJ2tyesKf3S0IxSrkRLmB2ZN2ACSwy37gxY_AZoTagHWlZCOA"
                COMPUTE_GPAY_MERCHANT_ID = "BCR2DN6TZ6OMNHTP"
                COMPUTE_ALGOLIA_APPLICATION_ID = "KGUN8FAIPF"
                COMPUTE_ALGOLIA_SEARCH_KEY = "d4847002cd30392fe0fbd00a1da933ed"
                COMPUTE_API_ROOT = "https://cloud.staging.linode.com/api/v4"
                COMPUTE_APP_ROOT = "https://cloud.staging.linode.com"
                // TODO(SD-966): Replace these AkaChat values with staging-specific endpoints when they are available.
                COMPUTE_CHAT_BOOTSTRAP_JS_URL = "https://akamai.my.site.com/ESWAkaChatCompute1778779688044/assets/js/bootstrap.min.js"
                COMPUTE_CHAT_DEPLOYMENT_NAME = "AkaChat_Compute"
                COMPUTE_CHAT_DEPLOYMENT_URL = "https://akamai.my.site.com/ESWAkaChatCompute1778779688044"
                COMPUTE_CHAT_ORG_ID = "00DA0000000Hu5a"
                COMPUTE_CHAT_SCRT2_URL = "https://akamai.my.salesforce-scrt.com"
                COMPUTE_CLIENT_ID = "6714f4f895cbe13a5781"
                COMPUTE_ENVIRONMENT_NAME = "staging"
                COMPUTE_LISH_ROOT = "webconsole.linode.com"
                COMPUTE_LOGIN_ROOT = "https://login.staging.linode.com"
                COMPUTE_ADOBE_ANALYTICS_URL = "https://assets.adobedtm.com/fcfd3580c848/15e23aa7fce2/launch-5bda4b7a1db9-staging.min.js"
                COMPUTE_PENDO_API_KEY = "46f744c8-8628-4dc4-55f9-83fdd3bf2eef"
                COMPUTE_SENTRY_URL = "https://ec5fcee0daee4bc9bb74e5b614e27ee0@o83654.ingest.sentry.io/182732"
                COMPUTE_LAUNCHDARKLY_CLIENT_ID = "5ed11a54d310ac0a0e542702"
                COMPUTE_API_MAX_PAGE_SIZE = "500"
                COMPUTE_STATUS_PAGE_URL = "https://status.linode.com/api/v2"
                COMPUTE_INFERENCE_BASE_URL = "https://api-staging.akamai-inference.com/v1"
            }
            steps {
                nodejs(configId: "npmrc-ro", nodeJSInstallationName: "v22") {
                    sh "pnpm build"
                    sh "pnpm release --env=staging"
                    sh "pnpm release:cloudpulse --env=staging"
                }
            }
        }

        stage("Build master") {
            when {
                anyOf {
                    branch pattern: "master"
                    branch pattern: "master-cloud-manager-distributed"
                }
            }
            environment {
                COMPUTE_ADOBE_ANALYTICS_URL = "https://assets.adobedtm.com/fcfd3580c848/15e23aa7fce2/launch-9ea21650035a.min.js"
                COMPUTE_ALGOLIA_APPLICATION_ID = "KGUN8FAIPF"
                COMPUTE_ALGOLIA_SEARCH_KEY = "d4847002cd30392fe0fbd00a1da933ed"
                COMPUTE_API_MAX_PAGE_SIZE = "500"
                COMPUTE_API_ROOT = "https://cloud.linode.com/api/v4"
                COMPUTE_APP_ROOT = "https://cloud.linode.com"
                COMPUTE_CHAT_BOOTSTRAP_JS_URL = "https://akamai.my.site.com/ESWAkaChatCompute1778779688044/assets/js/bootstrap.min.js"
                COMPUTE_CHAT_DEPLOYMENT_NAME = "AkaChat_Compute"
                COMPUTE_CHAT_DEPLOYMENT_URL = "https://akamai.my.site.com/ESWAkaChatCompute1778779688044"
                COMPUTE_CHAT_ORG_ID = "00DA0000000Hu5a"
                COMPUTE_CHAT_SCRT2_URL = "https://akamai.my.salesforce-scrt.com"
                COMPUTE_CLIENT_ID = "04b4276a4094ce378d27"
                COMPUTE_ENVIRONMENT_NAME = "production"
                COMPUTE_GPAY_MERCHANT_ID = "BCR2DN6TZ6OMNHTP"
                COMPUTE_LAUNCHDARKLY_CLIENT_ID = "5cd5be32283709081fd70fbc"
                COMPUTE_LISH_ROOT = "webconsole.linode.com"
                COMPUTE_LOGIN_ROOT = "https://login.linode.com"
                COMPUTE_PAYPAL_CLIENT_ID = "AWdnFJ_Yx5X9uqKZQdbdkLfCnEJwtauQJ2tyesKf3S0IxSrkRLmB2ZN2ACSwy37gxY_AZoTagHWlZCOA"
                COMPUTE_PENDO_API_KEY = '46f744c8-8628-4dc4-55f9-83fdd3bf2eef'
                COMPUTE_SENTRY_URL = "https://ec5fcee0daee4bc9bb74e5b614e27ee0@o83654.ingest.sentry.io/182732"
                COMPUTE_STATUS_PAGE_URL = "https://status.linode.com/api/v2"
                COMPUTE_INFERENCE_BASE_URL = "https://api.akamai-inference.com/v1"
            }
            steps {
                nodejs(configId: "npmrc-ro", nodeJSInstallationName: "v22") {
                    sh "pnpm build"
                    sh "pnpm release --env=master"
                    sh "pnpm release:cloudpulse --env=master"
                }
            }
        }

        stage("Scan") {
            when {
                anyOf {
                    branch pattern: "develop"
                    branch pattern: "release/*"
                    branch pattern: "staging"
                    branch pattern: "master"
                    branch pattern: "master-cloud-manager-distributed"
                }
            }
            steps {
                pulsarBlackduck(bdApplicationId: "cloud-manager-distributed", jobType: "FRONTEND")
                pulsarSonar(jobType: "FREESTYLE", projectName: "cloud-manager-distributed", customSrc: true)
            }
        }
    }

    post {
        always {
            junit testResults: 'reports/vitest-junit*.xml', allowEmptyResults: true

            script {
                def xmlFiles = findFiles(glob: 'reports/vitest-junit*.xml')
                def summary         = ''
                def failedFilesHtml = ''

                if (xmlFiles.length > 0) {
                    // Single-line Python — avoids indented blocks that Jenkins
                    // whitespace-stripping would break (IndentationError).
                    summary = sh(returnStdout: true, script: '''python3 -c "import glob,xml.etree.ElementTree as ET; pairs=[(int(ts.get('tests',0)),int(ts.get('failures',0))) for f in glob.glob('reports/vitest-junit*.xml') for root in [ET.parse(f).getroot()] for ts in ([root] if root.tag=='testsuite' else root.findall('testsuite'))]; t,e=sum(p[0] for p in pairs),sum(p[1] for p in pairs); print(chr(10003 if e==0 else 10007),t-e,'passed,',e,'failed')"''').trim()
                    if (summary) {
                        currentBuild.description = summary
                    }

                    // Collect unique file paths of suites that had at least one failure.
                    def failedFiles = sh(returnStdout: true, script: '''python3 -c "import glob,xml.etree.ElementTree as ET; seen=set(); [print(fp) for xml in glob.glob('reports/vitest-junit*.xml') for root in [ET.parse(xml).getroot()] for ts in ([root] if root.tag=='testsuite' else root.findall('testsuite')) if int(ts.get('failures',0))>0 for fp in [ts.get('file',ts.get('name','?'))] if fp not in seen and not seen.add(fp)]"''').trim()
                    if (failedFiles) {
                        def rows = failedFiles.split('\n').collect { f ->
                            "<tr><td style=\"font-family:monospace;font-size:12px;color:#c62828;padding:2px 0\">${f}</td></tr>"
                        }.join('')
                        failedFilesHtml = """<tr><td style="color:#666;vertical-align:top;padding-top:8px">Failures</td><td><table cellpadding="0" cellspacing="2">${rows}</table></td></tr>"""
                    }
                }

                // ── Email notification ────────────────────────────────────────────
                // Requires SMTP configured in Jenkins global settings:
                //   Manage Jenkins → Configure System → Email Notification
                //
                // Routing:
                //   PR builds      → PR author only  (env.CHANGE_AUTHOR_EMAIL)
                //   mainline builds → team DL
                def TEAM_DL = 'dl-uie-team@akamai.com'

                def status     = currentBuild.currentResult
                def passed     = (status == 'SUCCESS')
                def color      = passed ? '#2e7d32' : '#c62828'
                def icon       = passed ? '✓' : '✗'
                def commitInfo = sh(returnStdout: true,
                    script: "git log -1 --pretty=format:'%h — %s (%an)'"
                ).trim()

                def isPR    = (env.CHANGE_ID != null || env.BITBUCKET_PR_ID != null)
                def toAddr  = isPR
                    ? (env.CHANGE_AUTHOR_EMAIL ?: TEAM_DL)   // fallback if var not set
                    : TEAM_DL

                def body = """<!DOCTYPE html><html><body style="font-family:sans-serif;margin:0;padding:0;background:#f5f5f5">
<table width="100%" cellpadding="0" cellspacing="0"><tr><td style="padding:24px">
  <table width="600" cellpadding="0" cellspacing="0" style="background:#fff;border-radius:6px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.15)">
    <tr><td style="background:${color};padding:20px 28px">
      <span style="color:#fff;font-size:20px;font-weight:600">${icon} Cloud Manager — ${env.BRANCH_NAME} #${env.BUILD_NUMBER} build ${status.toLowerCase()}</span>
    </td></tr>
    <tr><td style="padding:24px 28px">
      <table cellpadding="6" cellspacing="0" style="width:100%;font-size:14px;color:#333">
        <tr><td style="color:#666;width:90px">Branch</td><td><strong>${env.BRANCH_NAME}</strong></td></tr>
        <tr><td style="color:#666">Build</td><td>#${env.BUILD_NUMBER}</td></tr>
        <tr><td style="color:#666">Commit</td><td style="font-family:monospace;font-size:13px">${commitInfo}</td></tr>
        <tr><td style="color:#666">Tests</td><td>${summary ?: 'no report generated (infra-only change)'}</td></tr>
        ${failedFilesHtml}
      </table>
      <div style="margin-top:24px">
        <a href="${env.BUILD_URL}" style="background:${color};color:#fff;padding:10px 20px;border-radius:4px;text-decoration:none;font-size:14px;font-weight:500">View build →</a>
      </div>
    </td></tr>
  </table>
</td></tr></table>
</body></html>"""

                mail(
                    to:       toAddr,
                    subject:  "[cloud-manager] ${icon} ${status} — ${env.BRANCH_NAME} #${env.BUILD_NUMBER} | ${summary ?: 'no tests run'}",
                    body:     body,
                    mimeType: 'text/html'
                )
            }
        }
    }
}
